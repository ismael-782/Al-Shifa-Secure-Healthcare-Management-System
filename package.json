{
  "name": "as-shifa-healthcare",
  "version": "1.0.0",
  "description": "As-Shifa Secure Healthcare Management System — HIPAA-aligned",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "db:schema": "psql $DATABASE_URL -f backend/db/schema.sql",
    "db:seed": "psql $DATABASE_URL -f backend/db/seed.sql",
    "db:reset": "node backend/db/reset.js",
    "pretest": "node tests/reset-test-db.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-session": "^1.18.0",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "nodemailer": "^6.9.13",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "UNLICENSED"
}
