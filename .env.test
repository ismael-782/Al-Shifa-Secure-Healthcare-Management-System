# ============================================================
# As-Shifa Healthcare — Test Environment (non-secret overrides only)
# ============================================================
# Used ONLY by the automated test suite (tests/) and CI. Deliberately
# contains NO credentials or secrets — DB_PASSWORD, SESSION_SECRET,
# ENCRYPTION_KEY, HMAC_SECRET etc. are intentionally absent here.
#
# Local runs: tests/helpers.js and tests/reset-test-db.js load your real
# .env FIRST (for actual DB credentials/secrets — never committed), then
# this file on top for test-specific overrides only (dotenv never
# overwrites a variable that's already set, so this file can only add
# values .env doesn't already define).
#
# CI runs: there is no .env file at all (never committed) — instead
# .github/workflows/ci.yml sets DB credentials and dummy crypto secrets
# directly as step-level environment variables, scoped to that run's
# disposable Postgres container. This file fills in the rest there too.
#
# Tests target a dedicated Postgres *schema* (DB_SCHEMA) inside the same
# database as dev — never the `public` schema your dev/demo data lives in.
# See backend/db/reset.js for how that isolation is enforced.
# ============================================================

NODE_ENV=test
PORT=3999

DB_SCHEMA=test_suite

MFA_OTP_EXPIRY_MINUTES=10
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@asshifa.health
SMTP_PASS=unused-in-tests
SMTP_FROM="As-Shifa Test <noreply@asshifa.health>"

SESSION_TIMEOUT_MS=900000
MAX_FAILED_LOGINS=5
# Lower bcrypt cost than dev/prod (12) — the suite does many register/login
# calls, and bcrypt's cost factor doesn't change which code path is tested.
BCRYPT_ROUNDS=4

RATE_LIMIT_WINDOW_MS=60000
# High enough that the test suite's own request volume never trips it.
RATE_LIMIT_MAX_REQUESTS=1000

FRONTEND_ORIGIN=http://localhost:3999
ADMIN_ALERT_EMAIL=admin@asshifa.health
