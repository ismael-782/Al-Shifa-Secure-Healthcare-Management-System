# ============================================================
# As-Shifa Healthcare — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── Node Environment ─────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── PostgreSQL Database ──────────────────────────────────────
DATABASE_URL=postgresql://asshifa_user:STRONG_PASSWORD@localhost:5432/asshifa_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=asshifa_db
DB_USER=asshifa_user
DB_PASSWORD=STRONG_DB_PASSWORD_HERE

# ── Session Security ─────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=8cdcc3640b9bc245ad68e282584a3e1a6e8dad4cd5e35907b450093dd295b2a78a469b988a99841916179585c04295d99850b1dd5c115e956b9ed4109d97b7c9

# ── AES-256-CBC Encryption ───────────────────────────────────
# 32-byte (256-bit) key for field-level encryption (CONF-01)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=57a8229f84d5186199736d24a5efb4887103bcc85f648a2ad1bfd8e721440fb1

# ── HMAC Signature Secret ────────────────────────────────────
# For prescription digital signatures (INT-05)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
HMAC_SECRET=2a74518c92e8f65f8cb2e72edc0f95bded28fef34a3656aa69168f569041ce34a85093e7720a3fb7978cad887a0794fe3f6c88e662e7badd033dd86c59954b40

# ── MFA / Email OTP ──────────────────────────────────────────
MFA_OTP_EXPIRY_MINUTES=10
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@asshifa.health
SMTP_PASS=SMTP_PASSWORD_HERE
SMTP_FROM="As-Shifa System <noreply@asshifa.health>"

# ── Session & Auth ───────────────────────────────────────────
SESSION_TIMEOUT_MS=900000
MAX_FAILED_LOGINS=5
BCRYPT_ROUNDS=12

# ── Rate Limiting (AVL-03) ───────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# ── CORS ─────────────────────────────────────────────────────
FRONTEND_ORIGIN=https://yourdomain.com

# ── SSL/TLS (CONF-02) ────────────────────────────────────────
# For production, use a reverse proxy (nginx) with Let's Encrypt.
# If running Express HTTPS directly:
# SSL_KEY_PATH=/etc/ssl/private/asshifa.key
# SSL_CERT_PATH=/etc/ssl/certs/asshifa.crt

# ── Admin Alert Email ────────────────────────────────────────
ADMIN_ALERT_EMAIL=admin@asshifa.health
